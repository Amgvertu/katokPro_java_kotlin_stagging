<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Карточка объявления -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Цветная полоса -->
                <View
                    android:id="@+id/view_strip"
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent" />

                <!-- Основной контент -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Тег и бейджи -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_tag"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent" />

                        <LinearLayout
                            android:id="@+id/ll_badges"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <!-- Название ЛДС -->
                    <TextView
                        android:id="@+id/tv_rink"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:paddingTop="4dp"
                        android:paddingBottom="2dp" />

                    <!-- Адрес ЛДС -->
                    <TextView
                        android:id="@+id/tv_rink_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:paddingBottom="8dp"
                        android:visibility="gone" />

                    <!-- Дата и время -->
                    <TextView
                        android:id="@+id/tvDateTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:paddingBottom="4dp" />

                    <!-- Уровень -->
                    <TextView
                        android:id="@+id/tv_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="@drawable/bg_tag"
                        android:textSize="11sp"
                        android:textColor="#000000"
                        android:layout_marginStart="0dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Доставка -->
                    <TextView
                        android:id="@+id/tv_delivery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:paddingBottom="4dp"
                        android:visibility="gone" />

                    <!-- Оплата -->
                    <TextView
                        android:id="@+id/tv_payment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:paddingBottom="4dp"
                        android:visibility="gone" />

                    <!-- Количество игроков (блок) -->
                    <LinearLayout
                        android:id="@+id/layout_players_needed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="8dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_goalies"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_defenders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_forwards"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Автор -->
                    <TextView
                        android:id="@+id/tv_author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/primary"
                        android:paddingBottom="4dp" />

                    <!-- Телефон -->
                    <TextView
                        android:id="@+id/tv_phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:paddingBottom="8dp"
                        android:visibility="gone" />

                    <!-- Разделитель -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_border"
                        android:layout_marginHorizontal="0dp" />

                    <!-- Блок откликнувшихся -->
                    <TextView
                        android:id="@+id/tvResponsesHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Откликнулись"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:paddingTop="8dp"
                        android:paddingBottom="10dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvResponses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:padding="4dp"
                        android:visibility="gone" />

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Кнопки управления (только для администратора) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnArchive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="В архив"
                style="@style/ButtonOutline"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Редактировать"
                style="@style/ButtonOutline"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Удалить"
                style="@style/ButtonOutline"
                android:backgroundTint="@color/error" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← Назад"
            style="@style/ButtonOutline"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>