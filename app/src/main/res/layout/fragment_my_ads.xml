<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Верхняя часть: заголовок и панель фильтров -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Мои объявления"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_filter"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:contentDescription="Фильтр"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- ПАНЕЛЬ ФИЛЬТРОВ -->
        <LinearLayout
            android:id="@+id/filterPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/white"
            android:visibility="gone"
            android:elevation="4dp">

            <!-- Строка 1: Тип объявления и Дата -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Тип объявления -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Тип объявления"
                        android:textSize="12sp"
                        android:textColor="@color/accent"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_white"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvTypeValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Все"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary" />

                        <ImageButton
                            android:id="@+id/btnClearType"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_close"
                            android:background="?attr/selectableItemBackground"
                            android:padding="2dp"
                            android:visibility="gone"
                            android:contentDescription="Сбросить тип"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Дата -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Дата"
                        android:textSize="12sp"
                        android:textColor="@color/accent"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_white"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvDateValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Любая"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary" />

                        <ImageButton
                            android:id="@+id/btnClearDate"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_close"
                            android:background="?attr/selectableItemBackground"
                            android:padding="2dp"
                            android:visibility="gone"
                            android:contentDescription="Сбросить дату"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Строка 2: Статус и Отклики -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Статус -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Статус"
                        android:textSize="12sp"
                        android:textColor="@color/accent"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_white"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvStatusValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Все"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary" />

                        <ImageButton
                            android:id="@+id/btnClearStatus"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_close"
                            android:background="?attr/selectableItemBackground"
                            android:padding="2dp"
                            android:visibility="gone"
                            android:contentDescription="Сбросить статус"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Отклики -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Отклики"
                        android:textSize="12sp"
                        android:textColor="@color/accent"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_white"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvResponsesValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Все"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary" />

                        <ImageButton
                            android:id="@+id/btnClearResponses"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_close"
                            android:background="?attr/selectableItemBackground"
                            android:padding="2dp"
                            android:visibility="gone"
                            android:contentDescription="Сбросить фильтр откликов"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Строка 3. Сброс фильтров-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end">


                <Button
                    android:id="@+id/btnClearAllFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✖ Сбросить все"
                    android:textSize="10sp"
                    android:layout_marginTop="0dp"
                    android:background="?attr/selectableItemBackground"
                    android:textColor="@color/primary"
                    android:layout_marginStart="30sp" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Список объявлений -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5sp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Нет объявлений"
                android:textSize="16sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>